[Unit]
Description=IIT Project Management
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iitpm
Group=iitpm
WorkingDirectory=/opt/iit-pm/current
EnvironmentFile=/opt/iit-pm/.env
ExecStart=/opt/iit-pm/runtime/bin/node /opt/iit-pm/current/apps/server/dist/main.js
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/iit-pm/data /opt/iit-pm/backups
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
